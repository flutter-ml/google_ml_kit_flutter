#!/bin/bash
# Pre-commit hook for google_ml_kit_flutter
# Enforces secret protection, git hygiene, and Dart / Kotlin / Swift linting on staged files.

set -e

# Ensure PATH includes Flutter, Dart, Homebrew, and user bins when invoked by GUI Git clients (Fork, VS Code, Tower, etc.)
export PATH="$HOME/workspace/flutter/bin:$HOME/development/flutter/bin:$HOME/flutter/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.pub-cache/bin:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "🔍 Running pre-commit checks..."

# ------------------------------------------------------------------------------
# 1. Secret & Sensitive File Leak Prevention
# ------------------------------------------------------------------------------
echo "🔒 Check 1/5: Checking for secrets and sensitive files..."
STAGED_SECRETS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.env$|\.env\.|\.pem$|\.key$|google-services\.json$|GoogleService-Info\.plist$' || true)
if [ -n "$STAGED_SECRETS" ]; then
  echo "❌ Error: Attempting to commit sensitive/secret files:"
  echo "$STAGED_SECRETS"
  echo "Please unstage these files before committing."
  exit 1
fi

STAGED_ADDED_LINES=$(git diff --cached --diff-filter=ACMR -U0 | grep '^+' | grep -v '^+++' || true)
if [ -n "$STAGED_ADDED_LINES" ]; then
  if echo "$STAGED_ADDED_LINES" | grep -q -E -e '-----BEGIN (RSA|OPENSSH|PRIVATE) KEY-----|AKIA[0-9A-Z]{16}'; then
    echo "❌ Error: Hardcoded private keys or AWS access keys detected in staged changes!"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# 2. Git Hygiene Checks (Conflict Markers)
# ------------------------------------------------------------------------------
echo "🧹 Check 2/5: Checking git hygiene and conflict markers..."
if [ -n "$STAGED_ADDED_LINES" ]; then
  if echo "$STAGED_ADDED_LINES" | grep -q -E -e '^\+(<<<<<<< |=======$|>>>>>>> )'; then
    echo "❌ Error: Unresolved merge conflict markers (<<<<<<< / ======= / >>>>>>>) detected in staged files!"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# 3. Dart Code Formatting & Analysis
# ------------------------------------------------------------------------------
STAGED_DART_FILES=()
while IFS= read -r file; do
  [ -n "$file" ] && STAGED_DART_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$' | grep -v -E '\.g\.dart$|\.freezed\.dart$' || true)

if [ "${#STAGED_DART_FILES[@]}" -gt 0 ]; then
  echo "🎨 Check 3/5: Checking Dart formatting and static analysis (${#STAGED_DART_FILES[@]} file(s))..."
  if ! command -v dart &>/dev/null || ! command -v flutter &>/dev/null; then
    echo "❌ Error: 'dart' and/or 'flutter' not found in PATH."
    exit 1
  fi

  if ! dart format --output=none --set-exit-if-changed "${STAGED_DART_FILES[@]}"; then
    echo ""
    echo "❌ Error: Unformatted Dart code detected. Run 'dart format .' and re-stage."
    exit 1
  fi

  DART_PACKAGE_DIRS=()
  while IFS= read -r pkg_dir; do
    [ -n "$pkg_dir" ] && DART_PACKAGE_DIRS+=("$pkg_dir")
  done < <(printf '%s\n' "${STAGED_DART_FILES[@]}" | awk -F/ '$1 == "packages" && NF >= 2 { print $1 "/" $2 }' | sort -u)

  if [ "${#DART_PACKAGE_DIRS[@]}" -gt 0 ]; then
    for pkg_dir in "${DART_PACKAGE_DIRS[@]}"; do
      if [ -d "$pkg_dir" ]; then
        (cd "$pkg_dir" && flutter analyze)
      fi
    done
  else
    flutter analyze .
  fi
else
  echo "⏭️  Check 3/5: No staged Dart files; skipping Dart checks."
fi

# ------------------------------------------------------------------------------
# 4. Kotlin Linting (ktlint)
# ------------------------------------------------------------------------------
STAGED_KOTLIN_FILES=()
while IFS= read -r file; do
  [ -n "$file" ] && STAGED_KOTLIN_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts)$' || true)

if [ "${#STAGED_KOTLIN_FILES[@]}" -gt 0 ]; then
  echo "🟣 Check 4/5: Running ktlint on ${#STAGED_KOTLIN_FILES[@]} Kotlin file(s)..."
  if ! command -v ktlint &>/dev/null; then
    echo "❌ Error: ktlint is not installed. Install it with:"
    echo "  brew install ktlint"
    exit 1
  fi

  if ! ktlint "${STAGED_KOTLIN_FILES[@]}"; then
    echo ""
    echo "❌ Error: ktlint violations found. Run 'ktlint --format' (or './scripts/analyze.sh') and re-stage."
    exit 1
  fi
else
  echo "⏭️  Check 4/5: No staged Kotlin files; skipping ktlint."
fi

# ------------------------------------------------------------------------------
# 5. Swift Linting (SwiftLint)
# ------------------------------------------------------------------------------
STAGED_SWIFT_FILES=()
while IFS= read -r file; do
  [ -n "$file" ] && STAGED_SWIFT_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR | grep '\.swift$' || true)

if [ "${#STAGED_SWIFT_FILES[@]}" -gt 0 ]; then
  echo "🧡 Check 5/5: Running SwiftLint (--strict) on ${#STAGED_SWIFT_FILES[@]} Swift file(s)..."
  if ! command -v swiftlint &>/dev/null; then
    if [[ "$(uname -s)" == "Darwin" ]]; then
      echo "❌ Error: swiftlint is not installed. Install it with:"
      echo "  brew install swiftlint"
      exit 1
    else
      echo "⚠️  Warning: swiftlint is not installed on $(uname -s); skipping local Swift check (CI will verify)."
    fi
  else
    if ! swiftlint lint --strict --config "$REPO_ROOT/.swiftlint.yml" "${STAGED_SWIFT_FILES[@]}"; then
      echo ""
      echo "❌ Error: SwiftLint violations found. Run 'swiftlint lint --fix' (or './scripts/analyze.sh') and re-stage."
      exit 1
    fi
  fi
else
  echo "⏭️  Check 5/5: No staged Swift files; skipping SwiftLint."
fi

echo "✅ All pre-commit checks passed!"
exit 0
